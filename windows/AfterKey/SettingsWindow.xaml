<Window x:Class="AfterKey.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AfterKey Settings"
        Width="420" Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <TabControl Margin="10">

        <!-- General -->
        <TabItem Header="General">
            <StackPanel Margin="15" Spacing="12">
                <GroupBox Header="General Settings">
                    <StackPanel Margin="10" Spacing="10">
                        <DockPanel>
                            <TextBlock Text="Display Duration (s)" VerticalAlignment="Center" />
                            <TextBlock x:Name="DurationLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
                        </DockPanel>
                        <Slider x:Name="DurationSlider" Minimum="0.5" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                ValueChanged="OnDurationChanged" />

                        <DockPanel>
                            <TextBlock Text="Max Items" VerticalAlignment="Center" />
                            <TextBlock x:Name="MaxKeysLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
                        </DockPanel>
                        <Slider x:Name="MaxKeysSlider" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnMaxKeysChanged" />

                        <CheckBox x:Name="ShowModifiersCheck" Content="Show Modifier Keys"
                                  Checked="OnShowModifiersChanged" Unchecked="OnShowModifiersChanged" />
                    </StackPanel>
                </GroupBox>

                <Button Content="Reset to Defaults" Click="OnReset" Padding="10,6" />
            </StackPanel>
        </TabItem>

        <!-- Appearance -->
        <TabItem Header="Appearance">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15" Spacing="12">
                    <GroupBox Header="Appearance">
                        <StackPanel Margin="10" Spacing="10">
                            <DockPanel>
                                <TextBlock Text="Font Size" VerticalAlignment="Center" />
                                <TextBlock x:Name="FontSizeLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
                            </DockPanel>
                            <Slider x:Name="FontSizeSlider" Minimum="16" Maximum="64" TickFrequency="2" IsSnapToTickEnabled="True"
                                    ValueChanged="OnFontSizeChanged" />

                            <DockPanel>
                                <TextBlock Text="Corner Radius" VerticalAlignment="Center" />
                                <TextBlock x:Name="CornerRadiusLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
                            </DockPanel>
                            <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="30" TickFrequency="2" IsSnapToTickEnabled="True"
                                    ValueChanged="OnCornerRadiusChanged" />

                            <DockPanel>
                                <TextBlock Text="Border Width" VerticalAlignment="Center" />
                                <TextBlock x:Name="BorderWidthLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
                            </DockPanel>
                            <Slider x:Name="BorderWidthSlider" Minimum="0" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    ValueChanged="OnBorderWidthChanged" />

                            <Separator />
                            <DockPanel>
                                <TextBlock Text="Background Color" VerticalAlignment="Center" />
                                <Button x:Name="BgColorBtn" Width="40" Height="25" HorizontalAlignment="Right" Click="OnPickBgColor" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Background Opacity" VerticalAlignment="Center" />
                                <TextBlock x:Name="BgOpacityLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
                            </DockPanel>
                            <Slider x:Name="BgOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="OnBgOpacityChanged" />

                            <Separator />
                            <DockPanel>
                                <TextBlock Text="Text Color" VerticalAlignment="Center" />
                                <Button x:Name="TextColorBtn" Width="40" Height="25" HorizontalAlignment="Right" Click="OnPickTextColor" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Text Opacity" VerticalAlignment="Center" />
                                <TextBlock x:Name="TextOpacityLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
                            </DockPanel>
                            <Slider x:Name="TextOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="OnTextOpacityChanged" />

                            <Separator />
                            <DockPanel>
                                <TextBlock Text="Border Color" VerticalAlignment="Center" />
                                <Button x:Name="BorderColorBtn" Width="40" Height="25" HorizontalAlignment="Right" Click="OnPickBorderColor" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Border Opacity" VerticalAlignment="Center" />
                                <TextBlock x:Name="BorderOpacityLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
                            </DockPanel>
                            <Slider x:Name="BorderOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="OnBorderOpacityChanged" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Position -->
        <TabItem Header="Position">
            <StackPanel Margin="15">
                <GroupBox Header="Overlay Position">
                    <UniformGrid Rows="3" Columns="3" Margin="10" Height="200">
                        <Button Content="Top Left" Tag="top_left" Click="OnPositionClick" />
                        <Button Content="Top Center" Tag="top_center" Click="OnPositionClick" />
                        <Button Content="Top Right" Tag="top_right" Click="OnPositionClick" />
                        <Button Content="Center Left" Tag="center_left" Click="OnPositionClick" />
                        <Button Content="Center" Tag="center" Click="OnPositionClick" />
                        <Button Content="Center Right" Tag="center_right" Click="OnPositionClick" />
                        <Button Content="Bottom Left" Tag="bottom_left" Click="OnPositionClick" />
                        <Button Content="Bottom Center" Tag="bottom_center" Click="OnPositionClick" />
                        <Button Content="Bottom Right" Tag="bottom_right" Click="OnPositionClick" />
                    </UniformGrid>
                </GroupBox>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
